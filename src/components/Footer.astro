---

import { profile } from '../data/profile';

// SVG path data keyed by social icon name — DRY icon lookup
const svgPaths: Record<string, string> = {
  github:   '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  twitter:  '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  mastodon: '<path d="M21.58 13.913c-.29 1.469-2.592 3.121-5.238 3.396-1.379.184-2.737.368-4.185.276-2.368-.092-4.237-.551-4.237-.551 0 .184.014.459.043.643.308 2.294 2.317 2.478 4.22 2.57 1.922.092 3.633-.46 3.633-.46l.079 1.653s-1.344.734-3.738.918c-1.32.092-2.96-.046-4.869-.551-4.14-1.102-4.853-5.507-4.961-10.005-.034-1.285-.013-2.57-.013-3.58C2.334 3.75 4.778 2.007 8.014 1.48c3.236-.528 7.136 0 7.136 0s1.52.273 2.24 1.469c0 0 1.37-.46 2.16 1.194.788 1.654.616 5.416.616 5.416"/>',
  rss:      '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
};
---

<footer class="site-footer reveal" aria-label="Site footer">
  <div class="footer glass container">
    <div class="footer__brand">
      <strong class="footer__name">{profile.name}</strong>
      <p class="footer__tagline">{profile.title}</p>
    </div>

    <nav class="footer__socials" aria-label="Social media links">
      <ul role="list">
        {profile.socials.map(social => (
          <li>
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="social-link"
              aria-label={social.label}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={svgPaths[social.icon] ?? ''}
              />
              <span>{social.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={profile.donateUrl}
      class="footer__donate"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/>
      </svg>
      Support my work
    </a>

    <p class="footer__copy">
      <small>
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
        using modern CSS — view transitions, scroll-driven animations, @property, container queries,
        color-mix(), oklch(), popover API &amp; @starting-style.
        &copy; {new Date().getFullYear()} {profile.name}.
      </small>
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 2rem;
    position: relative;
    z-index: 1;
  }

  .footer {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto auto;
    column-gap: 3rem;
    row-gap: 1.25rem;
    padding: 2rem;
    align-items: start;
  }

  .footer__brand   { grid-column: 1; grid-row: 1; }
  .footer__socials { grid-column: 2; grid-row: 1 / 3; align-self: start; }
  .footer__donate  { grid-column: 1; grid-row: 2; }
  .footer__copy    { grid-column: 1 / -1; grid-row: 3; }

  .footer__name {
    display: block;
    font-size: 1.05rem;
    font-weight: 700;
    margin-bottom: 0.25rem;
  }

  .footer__tagline {
    font-size: 0.85rem;
    color: var(--clr-muted);
    text-wrap: balance;
  }

  /* Social links */
  .footer__socials ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: flex-end;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--clr-border);
    background: var(--clr-surface);
    text-decoration: none;
    font-size: 0.8rem;
    color: var(--clr-muted);
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.15s;
  }
  .social-link:hover {
    color: var(--clr-text);
    border-color: var(--clr-accent);
    background: color-mix(in oklch, var(--clr-accent) 12%, transparent);
    transform: translateY(-2px);
  }

  /* Donate button */
  .footer__donate {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.125rem;
    border-radius: var(--radius-sm);
    border: 1px solid color-mix(in oklch, var(--clr-donate) 45%, transparent);
    background: color-mix(in oklch, var(--clr-donate) 15%, transparent);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--clr-donate);
    width: fit-content;
    transition: background 0.2s, transform 0.15s;
  }
  .footer__donate:hover {
    background: color-mix(in oklch, var(--clr-donate) 26%, transparent);
    transform: translateY(-2px);
  }

  /* Copyright */
  .footer__copy {
    padding-top: 1.25rem;
    border-top: 1px solid var(--clr-border);
    font-size: 0.78rem;
    color: var(--clr-muted);
    line-height: 1.6;
    text-wrap: pretty;
  }
  .footer__copy a {
    color: var(--clr-accent);
    text-decoration: none;
  }
  .footer__copy a:hover { text-decoration: underline; }

  @media (max-width: 580px) {
    .footer {
      grid-template-columns: 1fr;
    }
    .footer__socials {
      grid-column: 1;
      grid-row: auto;
    }
    .footer__socials ul { justify-content: flex-start; }
    .footer__donate  { grid-row: auto; }
    .footer__copy    { grid-row: auto; }
  }
</style>
