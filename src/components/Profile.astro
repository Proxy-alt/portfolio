---
import { profile } from '../data/profile';
---

<section id="profile" class="profile-section" aria-label="About me">
  <div class="container">
    <article class="profile glass" transition:name="profile-card">
      <!-- Animated avatar ring uses @property --bg-angle from global styles -->
      <div class="profile__avatar-wrap" aria-hidden="true">
        <div class="profile__avatar-ring"></div>
        <div class="profile__avatar">{profile.avatarInitials}</div>
      </div>

      <div class="profile__content">
        <header>
          <h1 class="profile__name" transition:name="profile-name">{profile.name}</h1>
          <p class="profile__title">{profile.title}</p>
        </header>

        <!-- details/summary gives CSS-only expand/collapse — semantic & accessible -->
        <details class="profile__details">
          <summary class="profile__summary">
            <div class="profile__bio-wrap">
              <p class="profile__bio">{profile.bio}</p>
              <!-- Gradient fade mask applied via CSS; removed when [open] -->
              <div class="profile__bio-fade" aria-hidden="true"></div>
            </div>

            <span class="profile__toggle" aria-hidden="true">
              <!-- CSS swaps text via content: on :not([open]) / [open] -->
              <span class="toggle-label"></span>
              <svg class="toggle-arrow" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12l7 7 7-7"/>
              </svg>
            </span>
          </summary>

          <div class="profile__extended">
            {profile.extendedBio.split('\n\n').map(para => <p>{para}</p>)}
          </div>
        </details>
      </div>
    </article>

    <!-- Scroll indicator — bounces via CSS animation -->
    <div class="scroll-hint" aria-hidden="true">
      <span>Scroll to explore</span>
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 5v14M5 12l7 7 7-7"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .profile-section {
    min-height: calc(100svh - var(--nav-h) - 1.5rem);
    display: flex;
    align-items: center;
    /* Page-load entrance (not scroll-driven — it's always visible first) */
    animation: slide-up 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: 0.1s;
  }

  .profile {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(1.5rem, 4vw, 3rem);
    /* Container query for inline layout switch */
    container-type: inline-size;
  }

  @container (max-width: 520px) {
    .profile {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }
    .profile__toggle { align-self: center; }
    .profile__extended { text-align: left; }
  }

  /* ─── Avatar ──────────────────────────────── */
  .profile__avatar-wrap {
    position: relative;
    flex-shrink: 0;
    width: clamp(5rem, 12vw, 8rem);
    height: clamp(5rem, 12vw, 8rem);
  }

  .profile__avatar {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--clr-accent) 0%, var(--clr-accent-2) 100%);
    display: grid;
    place-items: center;
    font-size: clamp(1.4rem, 3.5vw, 2.25rem);
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
  }

  /* Spinning conic-gradient ring — driven by @property --bg-angle */
  .profile__avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(
      from var(--bg-angle),
      var(--clr-accent),
      var(--clr-accent-2),
      var(--clr-accent-3),
      var(--clr-accent)
    );
    animation: rotate-bg 5s linear infinite;
    z-index: 0;
  }
  .profile__avatar-ring::before {
    content: '';
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--clr-bg);
  }

  /* ─── Content ─────────────────────────────── */
  .profile__name {
    font-size: clamp(1.9rem, 2rem + 2vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    /* Gradient text */
    background: linear-gradient(135deg, var(--clr-text) 30%, var(--clr-muted) 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    line-height: 1.1;
    margin-bottom: 0.3rem;
  }

  .profile__title {
    font-size: 1rem;
    color: var(--clr-accent);
    font-weight: 500;
    margin-bottom: 1.25rem;
    text-wrap: pretty;
  }

  /* ─── Details / summary ───────────────────── */
  .profile__details { width: 100%; }

  .profile__summary {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .profile__bio-wrap { position: relative; }

  .profile__bio {
    color: var(--clr-muted);
    font-size: 1rem;
    line-height: 1.8;
    text-wrap: pretty;
    max-width: 65ch;
  }

  /* Fade overlay; hidden when details is open via :has() */
  .profile__bio-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 3.5rem;
    background: linear-gradient(to bottom, transparent, color-mix(in oklch, var(--clr-bg) 80%, transparent));
    pointer-events: none;
    transition: opacity 0.3s;
  }

  /* CSS :has() — hide the fade when parent details is open */
  .profile__details:has(> summary) .profile__bio-fade { opacity: 1; }
  .profile__details[open]          .profile__bio-fade { opacity: 0; }

  /* Toggle label text via CSS content — no JS */
  .toggle-label::before          { content: 'Read more'; }
  .profile__details[open] .toggle-label::before { content: 'Read less'; }

  .profile__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--clr-accent);
    align-self: flex-start;
    transition: gap 0.2s;
  }
  .profile__summary:hover .profile__toggle { gap: 0.55rem; }

  .toggle-arrow {
    transition: transform 0.3s ease;
    flex-shrink: 0;
  }
  .profile__details[open] .toggle-arrow { transform: rotate(180deg); }

  /* Extended bio */
  .profile__extended {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--clr-border);
    color: var(--clr-muted);
    line-height: 1.8;
    font-size: 0.95rem;
    text-wrap: pretty;
    animation: slide-up 0.4s ease both;
  }

  /* ─── Scroll hint ─────────────────────────── */
  .scroll-hint {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.5rem;
    color: var(--clr-muted);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    animation: bounce-down 2.2s ease-in-out infinite;
    animation-delay: 1s;
  }
</style>
