---

import OSSCard from './OSSCard.astro';
import { ossProjects } from '../data/oss';
---

<section id="oss" aria-labelledby="oss-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="oss-heading">Open Source</h2>
      <p>Projects I've built and maintain for the community.</p>
    </header>

    <!-- CSS container query controls column count based on available width -->
    <div class="oss-grid-container">
      <ul class="oss-grid" role="list">
        {ossProjects.map((project, i) => (
          <li>
            <OSSCard project={project} index={i} />
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .oss-grid-container {
    container-type: inline-size;
  }

  .oss-grid {
    display: grid;
    /* auto-fill with min/max — CSS-only responsive grid, no media queries */
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: 1.125rem;
    list-style: none;
  }

  /* Container query overrides for very wide containers */
  @container (min-width: 70rem) {
    .oss-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .oss-grid li { display: flex; }
</style>
