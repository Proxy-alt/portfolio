---
import type { CollectionEntry } from 'astro:content';
import type { GitHubStats } from '../lib/github';

interface Props {
  entry: CollectionEntry<'projects'>;
  stats?: GitHubStats;
  index: number;
}

const { entry, stats, index } = Astro.props;
const { title, summary, role, repo } = entry.data;

const stars = stats
  ? new Intl.NumberFormat('en', { notation: 'compact' }).format(stats.stargazerCount)
  : null;

const pushedAt = stats?.pushedAt
  ? new Intl.DateTimeFormat('en', { month: 'short', year: 'numeric' }).format(new Date(stats.pushedAt))
  : null;

const pushedAtIso = stats?.pushedAt ?? null;
---

<article
  class="project-card reveal"
  style={`--stagger: ${index}`}
  aria-labelledby={`proj-${entry.id}`}
>
  <header class="project-card__head">
    <h3 class="project-card__title" id={`proj-${entry.id}`}>
      <a
        href={`/projects/${entry.id}`}
        class="project-card__link"
      >
        {title}
      </a>
    </h3>
    <span class="project-card__role">{role}</span>
  </header>

  <p class="project-card__summary">{summary}</p>

  <footer class="project-card__foot">
    {stats?.primaryLanguage && (
      <span class="project-card__lang" aria-label={`Language: ${stats.primaryLanguage.name}`}>
        <span
          class="project-card__lang-dot"
          style={`background: ${stats.primaryLanguage.color}`}
          aria-hidden="true"
        ></span>
        {stats.primaryLanguage.name}
      </span>
    )}

    {stars && (
      <span class="project-card__stars">
        <span aria-hidden="true">★</span>
        <span>{stars}</span>
        <span class="sr-only">stars</span>
      </span>
    )}

    {pushedAt && pushedAtIso && (
      <time datetime={pushedAtIso} class="project-card__date">
        {pushedAt}
      </time>
    )}

    <a
      href={`https://github.com/${repo}`}
      class="project-card__gh"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`View ${title} on GitHub`}
    >
      GitHub
      <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M7 7h10v10M7 17 17 7"/>
      </svg>
    </a>
  </footer>
</article>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.75rem;
    border-radius: var(--radius);
    border: 1px solid var(--hairline);
    background: var(--paper);
    height: 100%;
    transition: box-shadow 0.2s, border-color 0.2s;
    animation-delay: calc(var(--stagger, 0) * 60ms);
  }
  .project-card:hover {
    border-color: color-mix(in oklab, var(--ink) 20%, transparent);
    box-shadow: var(--shadow-float);
  }

  .project-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-card__title {
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .project-card__link {
    text-decoration: none;
    color: var(--ink);
    transition: color 0.15s;
  }
  .project-card__link:hover { color: var(--accent); }

  .project-card__role {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .project-card__summary {
    flex: 1;
    font-size: 0.875rem;
    color: var(--ink-2);
    line-height: 1.65;
    text-wrap: pretty;
  }

  .project-card__foot {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    padding-top: 1rem;
    border-top: 1px solid var(--hairline);
    font-size: 0.8125rem;
    color: var(--ink-2);
    flex-wrap: wrap;
  }

  .project-card__lang {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: auto;
  }

  .project-card__lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .project-card__stars {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-variant-numeric: tabular-nums;
  }

  .project-card__date {
    color: var(--ink-2);
  }

  .project-card__gh {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    text-decoration: none;
    color: var(--accent);
    font-weight: 600;
    transition: color 0.15s;
  }
  .project-card__gh:hover { color: var(--accent-hover); }
</style>
