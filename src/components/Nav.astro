---
import { profile } from '../data/profile';

const links = [
  { label: 'Projects', href: '#projects' },
  { label: 'Contact',  href: '#contact' },
];
---

<header class="site-header">
  <div class="nav-bar container" role="banner">
    <a href="/" class="nav-brand" aria-label={`${profile.name} — Home`}>
      <span class="nav-brand__initials" aria-hidden="true">
        {profile.firstName[0]}{profile.lastName[0]}
      </span>
      <span class="nav-brand__name">{profile.name}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-links" role="list">
        {links.map((l) => (
          <li>
            <a href={l.href} class="nav-link">{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a
      href={`mailto:${profile.socials.find((s) => s.icon === 'mail')?.href.replace('mailto:', '')}`}
      class="nav-cta"
    >
      Get in touch
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    /* Scroll-driven hairline: fades in as you scroll past 1px */
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--nav-h);
    /* Translucent frosted surface */
    background: color-mix(in oklab, var(--paper) 80%, transparent);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    /* Scroll-driven border reveal */
  }

  /* Hairline appears once page has scrolled */
  @supports (animation-timeline: scroll()) {
    @media (prefers-reduced-motion: no-preference) {
      .site-header {
        animation: show-border linear both;
        animation-timeline: scroll();
        animation-range: 0px 60px;
      }
      @keyframes show-border {
        from { border-color: transparent; }
        to   { border-color: var(--hairline); }
      }
    }
  }

  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9375rem;
    color: var(--ink);
    flex-shrink: 0;
    margin-right: auto;
  }

  .nav-brand__initials {
    width: 1.875rem;
    height: 1.875rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    display: grid;
    place-items: center;
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  .nav-links {
    display: flex;
    gap: 0.25rem;
    list-style: none;
  }

  .nav-link {
    padding: 0.375rem 0.875rem;
    text-decoration: none;
    border-radius: var(--radius-pill);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: color 0.15s, background 0.15s;
    min-height: 2rem;
    display: flex;
    align-items: center;
  }
  .nav-link:hover {
    color: var(--ink);
    background: var(--panel);
  }

  .nav-cta {
    padding: 0.4375rem 1.125rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 600;
    flex-shrink: 0;
    transition: background 0.15s;
    min-height: 2rem;
    display: flex;
    align-items: center;
  }
  .nav-cta:hover { background: color-mix(in oklab, var(--ink) 85%, transparent); }

  @media (max-width: 540px) {
    .nav-links { display: none; }
  }
</style>
