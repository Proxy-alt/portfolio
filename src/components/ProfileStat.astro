---
import { profile } from '../data/profile';

interface Props {
  totalStars: number;
  repoCount: number;
}

const { totalStars, repoCount } = Astro.props;

const stats = [
  { label: 'Projects', value: repoCount },
  { label: 'Stars',    value: new Intl.NumberFormat('en', { notation: 'compact' }).format(totalStars) },
];

const svgPaths: Record<string, string> = {
  github:   '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  mastodon: '<path d="M21.58 13.913c-.29 1.469-2.592 3.121-5.238 3.396-1.379.184-2.737.368-4.185.276-2.368-.092-4.237-.551-4.237-.551 0 .184.014.459.043.643.308 2.294 2.317 2.478 4.22 2.57 1.922.092 3.633-.46 3.633-.46l.079 1.653s-1.344.734-3.738.918c-1.32.092-2.96-.046-4.869-.551-4.14-1.102-4.853-5.507-4.961-10.005-.034-1.285-.013-2.57-.013-3.58C2.334 3.75 4.778 2.007 8.014 1.48c3.236-.528 7.136 0 7.136 0s1.52.273 2.24 1.469c0 0 1.37-.46 2.16 1.194.788 1.654.616 5.416.616 5.416"/>',
  mail:     '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  twitter:  '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  rss:      '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
};
---

<section id="intro" aria-labelledby="intro-h" class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <p class="hero__location">{profile.location}</p>
      <h1 id="intro-h" class="hero__name">{profile.name}</h1>
      <p class="hero__tagline">{profile.tagline}</p>

      <dl class="stats">
        {stats.map(({ label, value }) => (
          <div class="stats__item">
            <dt class="stats__label">{label}</dt>
            <dd class="stats__value">{value}</dd>
          </div>
        ))}
      </dl>

      <nav aria-label="Social" class="social-nav">
        <ul role="list" class="social-list">
          {profile.socials.map((s) => (
            <li>
              <a
                href={s.href}
                class="social-link"
                aria-label={s.label}
                {...(s.href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  set:html={svgPaths[s.icon] ?? ''}
                />
                <span>{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="hero__avatar" aria-hidden="true">
      <span class="hero__initials">
        {profile.firstName[0]}{profile.lastName[0]}
      </span>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--nav-h));
    display: flex;
    align-items: center;
    background: var(--paper);
    padding-block: clamp(4rem, 10vw, 8rem);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .hero__location {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 1rem;
  }

  .hero__name {
    font-size: clamp(2.5rem, 2rem + 3.5vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--ink);
    line-height: 1.05;
    margin-bottom: 1rem;
  }

  .hero__tagline {
    font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
    color: var(--ink-2);
    max-width: 46ch;
    line-height: 1.5;
    margin-bottom: 2.5rem;
    font-weight: 400;
  }

  /* Stats — description list */
  .stats {
    display: flex;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  .stats__item {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .stats__value {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stats__label {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Social links */
  .social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .social-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--hairline);
    background: var(--paper);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    transition: color 0.15s, border-color 0.15s, background 0.15s;
    min-height: 2.5rem;
  }
  .social-link:hover {
    color: var(--ink);
    border-color: color-mix(in oklab, var(--ink) 30%, transparent);
    background: var(--panel);
  }

  /* Avatar */
  .hero__avatar {
    width: clamp(8rem, 15vw, 13rem);
    height: clamp(8rem, 15vw, 13rem);
    border-radius: 28%;
    background: var(--panel);
    display: grid;
    place-items: center;
    flex-shrink: 0;
    box-shadow: var(--shadow-float);
  }

  .hero__initials {
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 600px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
    .hero__avatar {
      display: none;
    }
  }
</style>
