---
import { profile } from '../data/profile';

const year = new Date().getFullYear();

const emailSocial = profile.socials.find((s) => s.icon === 'mail');
const email = emailSocial?.href.replace('mailto:', '') ?? '';

const svgPaths: Record<string, string> = {
  github:   '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  mastodon: '<path d="M21.58 13.913c-.29 1.469-2.592 3.121-5.238 3.396-1.379.184-2.737.368-4.185.276-2.368-.092-4.237-.551-4.237-.551 0 .184.014.459.043.643.308 2.294 2.317 2.478 4.22 2.57 1.922.092 3.633-.46 3.633-.46l.079 1.653s-1.344.734-3.738.918c-1.32.092-2.96-.046-4.869-.551-4.14-1.102-4.853-5.507-4.961-10.005-.034-1.285-.013-2.57-.013-3.58C2.334 3.75 4.778 2.007 8.014 1.48c3.236-.528 7.136 0 7.136 0s1.52.273 2.24 1.469c0 0 1.37-.46 2.16 1.194.788 1.654.616 5.416.616 5.416"/>',
  mail:     '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  twitter:  '<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/>',
  linkedin: '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
  rss:      '<path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/>',
};
---

<footer id="contact" class="colophon" aria-labelledby="contact-h">
  <div class="container colophon__inner">
    <div class="colophon__contact">
      <h2 id="contact-h" class="colophon__heading">Let's work together.</h2>
      <p class="colophon__sub">Open to interesting problems.</p>
      {email && (
        <address class="colophon__address">
          <a href={`mailto:${email}`} class="colophon__email">{email}</a>
        </address>
      )}
    </div>

    <nav aria-label="Social" class="colophon__socials">
      <ul role="list" class="colophon__social-list">
        {profile.socials.filter((s) => s.icon !== 'mail').map((s) => (
          <li>
            <a
              href={s.href}
              class="colophon__social-link"
              aria-label={s.label}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                set:html={svgPaths[s.icon] ?? ''}
              />
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <p class="colophon__copy">
      <small>
        &copy; {year} {profile.name}.
        Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>,
        hand-written CSS, refreshed weekly.
      </small>
    </p>
  </div>
</footer>

<style>
  .colophon {
    background: var(--bg-dark);
    color: var(--ink-invert);
    padding-block: clamp(5rem, 10vw, 9rem);
  }

  .colophon__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    gap: 2rem 4rem;
    align-items: start;
  }

  .colophon__contact { grid-column: 1; grid-row: 1; }
  .colophon__socials { grid-column: 2; grid-row: 1; align-self: center; }
  .colophon__copy    { grid-column: 1 / -1; grid-row: 2; }

  .colophon__heading {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--ink-invert);
    margin-bottom: 0.5rem;
  }

  .colophon__sub {
    font-size: 1rem;
    color: color-mix(in oklab, var(--ink-invert) 60%, transparent);
    margin-bottom: 1.5rem;
  }

  .colophon__address { font-style: normal; }

  .colophon__email {
    font-size: clamp(1rem, 0.875rem + 0.5vw, 1.25rem);
    font-weight: 600;
    color: var(--accent-on-dark);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.15s;
  }
  .colophon__email:hover {
    color: color-mix(in oklab, var(--accent-on-dark) 80%, white);
  }

  .colophon__social-list {
    display: flex;
    gap: 0.5rem;
    list-style: none;
  }

  .colophon__social-link {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--ink-invert) 20%, transparent);
    color: color-mix(in oklab, var(--ink-invert) 70%, transparent);
    text-decoration: none;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }
  .colophon__social-link:hover {
    color: var(--ink-invert);
    border-color: color-mix(in oklab, var(--ink-invert) 50%, transparent);
    background: color-mix(in oklab, var(--ink-invert) 8%, transparent);
  }

  .colophon__copy {
    padding-top: 2rem;
    border-top: 1px solid color-mix(in oklab, var(--ink-invert) 10%, transparent);
    font-size: 0.8125rem;
    color: color-mix(in oklab, var(--ink-invert) 40%, transparent);
    line-height: 1.6;
  }
  .colophon__copy a {
    color: color-mix(in oklab, var(--ink-invert) 60%, transparent);
    text-decoration: none;
    transition: color 0.15s;
  }
  .colophon__copy a:hover {
    color: var(--ink-invert);
  }

  @media (max-width: 560px) {
    .colophon__inner {
      grid-template-columns: 1fr;
    }
    .colophon__socials {
      grid-column: 1;
      grid-row: auto;
    }
    .colophon__copy { grid-row: auto; }
  }
</style>
