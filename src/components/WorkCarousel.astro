---

import { workProjects } from '../data/work';

function hostname(url: string) {
  try { return new URL(url).hostname; }
  catch { return url; }
}
---

<section id="work" aria-labelledby="work-heading">
  <div class="container">
    <header class="section-header reveal">
      <h2 id="work-heading">Work</h2>
      <p>Companies and projects I've had the privilege of contributing to.</p>
    </header>

    <div class="carousel-wrap">
      <!-- CSS scroll-snap carousel — works without JS; arrows enhance it -->
      <div class="carousel" id="work-carousel" role="region" aria-label="Work projects carousel" aria-roledescription="carousel">
        {workProjects.map((project, i) => (
          <article
            class="slide glass"
            id={`slide-${i + 1}`}
            style={`--accent: ${project.accentColor}`}
            aria-label={`${project.company} — ${project.role}, slide ${i + 1} of ${workProjects.length}`}
            aria-roledescription="slide"
          >
            <div class="slide__body">
              <header class="slide__header">
                <div class="slide__meta">
                  <time class="slide__period">{project.period}</time>
                  <span class="slide__role">{project.role}</span>
                </div>
                <h3 class="slide__company">{project.company}</h3>
              </header>

              <p class="slide__desc">{project.description}</p>

              <ul class="slide__impact" role="list">
                {project.impact.map(item => (
                  <li class="slide__impact-item">
                    <span class="impact-arrow" aria-hidden="true">↗</span>
                    {item}
                  </li>
                ))}
              </ul>

              <ul class="slide__tags" role="list">
                {project.tags.map(tag => <li class="slide__tag">{tag}</li>)}
              </ul>
            </div>

            <footer class="slide__footer">
              <span class="slide__count" aria-hidden="true">
                {String(i + 1).padStart(2, '0')} / {String(workProjects.length).padStart(2, '0')}
              </span>

              <!-- URL in bottom-right with arrow — key UX requirement -->
              <a
                href={project.url}
                class="slide__visit"
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${project.company} at ${hostname(project.url)}`}
              >
                <span>{hostname(project.url)}</span>
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 7h10v10M7 17 17 7"/>
                </svg>
              </a>
            </footer>
          </article>
        ))}
      </div>

      <!-- CSS-only dot navigation via anchor links + scroll-snap -->
      <nav class="carousel__nav" aria-label="Carousel navigation">
        {workProjects.map((project, i) => (
          <a
            href={`#slide-${i + 1}`}
            class="carousel__dot"
            aria-label={`Go to ${project.company}`}
          ></a>
        ))}
      </nav>

      <!-- Arrow controls — minimal JS for scrollBy; carousel works without them -->
      <div class="carousel__arrows" aria-hidden="true">
        <button class="carousel__arrow" id="carousel-prev" tabindex="-1" aria-label="Previous">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
        </button>
        <button class="carousel__arrow" id="carousel-next" tabindex="-1" aria-label="Next">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="m9 18 6-6-6-6"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<style>
  /* ─── Carousel track ────────────────────── */
  .carousel-wrap { position: relative; }

  .carousel {
    display: flex;
    overflow-x: auto;
    /* CSS scroll snap — core feature, no JS needed */
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    gap: 1.5rem;
  }
  .carousel::-webkit-scrollbar { display: none; }

  /* ─── Slides ──────────────────────────── */
  .slide {
    scroll-snap-align: start;
    flex: 0 0 100%;
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 4vw, 2.5rem);
    min-height: 30rem;
    border-top: 3px solid var(--accent);
    /* Container query for the slide itself */
    container-type: inline-size;
  }

  .slide__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .slide__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .slide__period {
    font-size: 0.78rem;
    font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
    color: var(--clr-muted);
    background: var(--clr-surface);
    border: 1px solid var(--clr-border);
    border-radius: 100px;
    padding: 0.2rem 0.625rem;
  }

  .slide__role {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--accent);
  }

  .slide__company {
    font-size: clamp(1.6rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .slide__desc {
    color: var(--clr-muted);
    font-size: 1rem;
    line-height: 1.75;
    text-wrap: pretty;
    max-width: 62ch;
  }

  .slide__impact {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .slide__impact-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--clr-muted);
  }

  .impact-arrow {
    color: var(--accent);
    flex-shrink: 0;
    font-style: normal;
  }

  .slide__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    list-style: none;
    margin-top: auto;
  }

  .slide__tag {
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent);
    background: color-mix(in oklch, var(--accent) 13%, transparent);
    border: 1px solid color-mix(in oklch, var(--accent) 28%, transparent);
  }

  /* ─── Slide footer with URL ───────────── */
  .slide__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    margin-top: 1.5rem;
    border-top: 1px solid var(--clr-border);
  }

  .slide__count {
    font-family: 'Cascadia Code', 'Fira Code', 'Consolas', monospace;
    font-size: 0.78rem;
    color: var(--clr-muted);
  }

  /* URL with arrow — bottom-right of each slide */
  .slide__visit {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.4rem 0.875rem;
    border-radius: 100px;
    border: 1px solid var(--clr-border);
    background: var(--clr-surface);
    text-decoration: none;
    font-size: 0.82rem;
    color: var(--clr-muted);
    transition: color 0.2s, border-color 0.2s, background 0.2s, transform 0.15s;
  }
  .slide__visit:hover {
    color: var(--clr-text);
    border-color: var(--accent);
    background: color-mix(in oklch, var(--accent) 14%, transparent);
    transform: translateX(3px);
  }
  .slide__visit:hover svg { transition: transform 0.2s; transform: translate(2px, -2px); }

  /* ─── Dot navigation ──────────────────── */
  .carousel__nav {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .carousel__dot {
    display: block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 100px;
    background: var(--clr-border);
    transition: background 0.2s, width 0.3s ease, transform 0.2s;
  }
  .carousel__dot:hover  { background: var(--clr-muted); transform: scale(1.3); }
  .carousel__dot.active { background: var(--clr-accent); width: 1.5rem; }

  /* ─── Arrow buttons ───────────────────── */
  .carousel__arrows {
    position: absolute;
    top: 50%;
    left: -0.75rem;
    right: -0.75rem;
    transform: translateY(-50%);
    display: flex;
    justify-content: space-between;
    pointer-events: none;
  }

  .carousel__arrow {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--clr-surface);
    backdrop-filter: var(--blur-sm);
    -webkit-backdrop-filter: var(--blur-sm);
    border: 1px solid var(--clr-border);
    color: var(--clr-text);
    cursor: pointer;
    display: grid;
    place-items: center;
    pointer-events: auto;
    transition: background 0.2s, transform 0.15s, border-color 0.2s;
  }
  .carousel__arrow:hover {
    background: var(--clr-surface-h);
    border-color: var(--clr-border-h);
    transform: scale(1.1);
  }

  @media (max-width: 480px) {
    .carousel__arrows { display: none; }
  }
</style>

<script>
  const carousel = document.getElementById('work-carousel');
  const prev = document.getElementById('carousel-prev');
  const next = document.getElementById('carousel-next');
  const dots = document.querySelectorAll<HTMLAnchorElement>('.carousel__dot');

  if (carousel) {
    prev?.addEventListener('click', () => {
      carousel.scrollBy({ left: -carousel.clientWidth, behavior: 'smooth' });
    });
    next?.addEventListener('click', () => {
      carousel.scrollBy({ left: carousel.clientWidth, behavior: 'smooth' });
    });

    // Active dot highlight via IntersectionObserver
    const slides = carousel.querySelectorAll<HTMLElement>('.slide');
    const observer = new IntersectionObserver(
      entries => {
        for (const entry of entries) {
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            const idx = [...slides].indexOf(entry.target as HTMLElement);
            dots.forEach((dot, i) => dot.classList.toggle('active', i === idx));
          }
        }
      },
      { root: carousel, threshold: 0.5 },
    );

    slides.forEach(slide => observer.observe(slide));
  }
</script>
