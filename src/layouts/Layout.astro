---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import { websiteLd } from '../lib/schema';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article' | 'profile';
  image?: string;
  imageAlt?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const siteUrl = Astro.site?.href ?? 'https://yourname.dev/';
const siteLd = websiteLd(siteUrl, profile.name);
const { jsonLd, ...seoProps } = Astro.props;
const allJsonLd = jsonLd
  ? [siteLd, ...(Array.isArray(jsonLd) ? jsonLd : [jsonLd])]
  : [siteLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,300..800;1,14..32,300..700&display=swap"
      rel="stylesheet"
    />
    <SEO {...seoProps} jsonLd={allJsonLd} />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
  </body>
</html>
