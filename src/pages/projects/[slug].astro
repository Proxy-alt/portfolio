---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Colophon from '../../components/Colophon.astro';
import { fetchGitHubStats } from '../../lib/github';
import { projectLd } from '../../lib/schema';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, repo, role, highlights } = entry.data;

const statsMap = await fetchGitHubStats(profile.handle);
const stats = statsMap[repo];

const stars = stats
  ? new Intl.NumberFormat('en', { notation: 'compact' }).format(stats.stargazerCount)
  : null;

const pushedAt = stats?.pushedAt
  ? new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric' }).format(new Date(stats.pushedAt))
  : null;

const jsonLd = projectLd(entry.data, stats, profile.name);
---

<Layout
  title={title}
  description={summary}
  type="article"
  jsonLd={jsonLd}
>
  <article class="project-page">
    <div class="container">
      <header class="project-header">
        <a href="/" class="back-link">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          All projects
        </a>

        <h1 class="project-title">{title}</h1>
        <p class="project-summary">{summary}</p>

        <dl class="project-meta">
          <div>
            <dt>Role</dt>
            <dd>{role}</dd>
          </div>
          {stats?.primaryLanguage && (
            <div>
              <dt>Language</dt>
              <dd>
                <span
                  class="lang-dot"
                  style={`background: ${stats.primaryLanguage.color}`}
                  aria-hidden="true"
                ></span>
                {stats.primaryLanguage.name}
              </dd>
            </div>
          )}
          {stars && (
            <div>
              <dt>Stars</dt>
              <dd><span aria-hidden="true">★</span> {stars}</dd>
            </div>
          )}
          {pushedAt && stats?.pushedAt && (
            <div>
              <dt>Last push</dt>
              <dd><time datetime={stats.pushedAt}>{pushedAt}</time></dd>
            </div>
          )}
        </dl>

        <div class="project-actions">
          <a
            href={`https://github.com/${repo}`}
            class="btn-primary"
            target="_blank"
            rel="noopener noreferrer"
          >
            View on GitHub
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 7h10v10M7 17 17 7"/>
            </svg>
          </a>
        </div>
      </header>

      {highlights && highlights.length > 0 && (
        <section aria-labelledby="highlights-h" class="project-highlights">
          <h2 id="highlights-h">Highlights</h2>
          <ul class="highlights-list" role="list">
            {highlights.map((h) => <li>{h}</li>)}
          </ul>
        </section>
      )}

      <section aria-labelledby="story-h" class="project-body">
        <h2 id="story-h" class="sr-only">Project story</h2>
        <Content />
      </section>
    </div>
  </article>

  <Colophon />
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0,0,0,0);
    white-space: nowrap;
    border: 0;
  }

  .project-page {
    background: var(--paper);
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    margin-bottom: 2.5rem;
    transition: color 0.15s;
  }
  .back-link:hover { color: var(--ink); }

  .project-header {
    max-width: var(--measure);
    margin-bottom: 3rem;
  }

  .project-title {
    font-size: clamp(2rem, 1.5rem + 2.5vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.035em;
    color: var(--ink);
    margin-bottom: 1rem;
  }

  .project-summary {
    font-size: 1.125rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin-bottom: 2rem;
    text-wrap: pretty;
  }

  /* Meta — description list */
  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
    font-size: 0.875rem;
  }

  .project-meta > div {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }

  .project-meta dt {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .project-meta dd {
    font-weight: 600;
    color: var(--ink);
    display: flex;
    align-items: center;
    gap: 0.375rem;
  }

  .lang-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .project-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1.375rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .btn-primary:hover {
    background: color-mix(in oklab, var(--ink) 85%, transparent);
  }

  /* Highlights */
  .project-highlights {
    max-width: var(--measure);
    margin-bottom: 3rem;
    padding: 1.75rem;
    border-radius: var(--radius);
    background: var(--panel);
  }

  .project-highlights h2 {
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-2);
    margin-bottom: 1rem;
  }

  .highlights-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
  }

  .highlights-list li {
    padding-left: 1.25rem;
    position: relative;
    font-size: 0.9375rem;
    color: var(--ink);
    line-height: 1.5;
  }
  .highlights-list li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 600;
  }

  /* Body prose */
  .project-body {
    max-width: var(--measure);
  }

  .project-body :global(p) {
    font-size: 1rem;
    line-height: 1.75;
    color: var(--ink-2);
    margin-bottom: 1.25rem;
    text-wrap: pretty;
  }

  .project-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
